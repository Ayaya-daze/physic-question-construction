# Backend
HOST=127.0.0.1
PORT=8000
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# File-first storage
QUESTIONS_DIR=../questions
UPLOAD_DIR=./uploads
EXPORTS_DIR=./exports
MAX_UPLOAD_SIZE_MB=100

# Legacy compatibility database. The question body source of truth remains files.
DATABASE_URL=sqlite+aiosqlite:///./physics_questions.db
DATABASE_URL_SYNC=sqlite:///./physics_questions.db

# TeX/PDF export
LATEX_ENGINE=xelatex
LATEX_COMPILE_TIMEOUT_SECONDS=90
FILE_EXPORT_MAX_WORKERS=1
EXPORT_RETENTION_DAYS=30
UPLOAD_RETENTION_DAYS=14

# Optional vision/text API. Disabled by default.
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_MAX_TOKENS=4096
LLM_VISION_ENABLED=false

# Optional OpenAI-compatible embedding API. Retrieval falls back to local
# FTS5 plus the clearly-labelled hash-vector compatibility index when disabled.
EMBEDDING_ENABLED=false
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=60

# OCR is a hint provider only; page images and source text remain evidence.
OCR_LANG=chi_sim+eng+equ
OCR_DPI=300
