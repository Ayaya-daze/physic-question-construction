# ==================== 数据库配置 ====================
# PostgreSQL 连接字符串 (asyncpg 驱动)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/physics_questions
# PostgreSQL 同步连接字符串 (用于表创建等)
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/physics_questions

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379/0

# ==================== 后端服务配置 ====================
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api
DEBUG=false
# 允许的跨域来源 (JSON 数组格式)
CORS_ORIGINS=["http://localhost:3000"]

# ==================== 文件题库/运行时文件 ====================
# 本地默认：后端从项目根目录的 questions/ 读取题库。
QUESTIONS_DIR=../questions
UPLOAD_DIR=./uploads
EXPORTS_DIR=./exports
MAX_UPLOAD_SIZE_MB=100
LATEX_ENGINE=xelatex
LATEX_COMPILE_TIMEOUT_SECONDS=90
FILE_EXPORT_MAX_WORKERS=1
EXPORT_RETENTION_DAYS=30
UPLOAD_RETENTION_DAYS=14

# ==================== 前端配置 ====================
NEXT_PUBLIC_API_URL=http://localhost:8000
# Docker/生产自定义 server 使用；本地可留空或设为 http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000

# ==================== LLM 配置 ====================
# LLM_ENABLED=true
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_BASE_URL=
# OpenAI-compatible 读图模型才打开；DeepSeek text-only 不应打开。
# LLM_VISION_ENABLED=false

# ==================== OCR 配置（后期启用）====================
# OCR_ENGINE=paddleocr
# OCR_LANG=ch

# ==================== 对象存储配置（后期启用）====================
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=physics-questions

# ==================== JWT 认证配置（后期启用）====================
# JWT_SECRET_KEY=change-me-to-a-random-string
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=480
